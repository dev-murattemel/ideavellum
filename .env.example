# Bu dosyayı .env.local adıyla kopyala ve değerleri doldur. .env.local git'e girmez.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Faz 4 — Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Faz 4 — E-posta (resend.com → API Keys)
RESEND_API_KEY=
EMAIL_FROM=

# Faz 4 — Zamanlanmış işler için gizli anahtar (en az 16 karakter)
CRON_SECRET=

# Uygulamanın adresi (yerelde http://localhost:3000)
APP_URL=http://localhost:3000

# Faz 6
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
